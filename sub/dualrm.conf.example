# Copy to /home/root/dualrm/dualrm.conf on the sub tablet.
# WiFi address of the main tablet (used when no USB link is up). Leave empty for USB only.
MAIN_LAN=192.168.1.50

# Book mode (PDF/EPUB present on both tablets)
BOOK_LEFT=main      # tablet showing the left page: main | sub
BOOK_COVER=0        # 1: first page alone on the right, like a printed book
